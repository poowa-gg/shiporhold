# PayPal SANDBOX credentials only. Never put live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you create in the PayPal developer dashboard (needs a public URL)
PAYPAL_WEBHOOK_ID=
# Optional: defaults to the sandbox API
# PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Optional: shown as the sender on invoices
# INVOICER_NAME=My Shop
# INVOICER_EMAIL=
# Local testing only (ignored when NODE_ENV=production): accept webhooks without verifying signature
# SKIP_WEBHOOK_VERIFY=true
PORT=3000
